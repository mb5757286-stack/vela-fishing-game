<template>
  <div class="page">
    <stack class="stage">
      <image class="bg" src="{{bgSrc}}"></image>

      <div class="scene" if="{{screen === 'home'}}">
        <div class="col" if="{{mode === 'menu'}}">
          <text class="title">УТИНАЯ ФЕРМА</text>
          <image class="duck-img" src="{{duckSrc}}"></image>
          <text class="hungerline">Сытость: {{hungerPct}}%</text>
          <text class="stats">Скорость {{spd}}  Сила {{pow}}  Вынослив. {{sta}}</text>
          <text class="hint">Тап — покормить</text>
          <text class="hint">Долгий тап — тренировка</text>
        </div>

        <div class="col" if="{{mode === 'feed'}}">
          <text class="title">КОРМЛЕНИЕ</text>
          <div class="feedbox">
            <image class="falling" for="{{foodItems}}" src="{{$item.src}}"
                   style="margin-left: {{$item.x}}px; margin-top: {{$item.y}}px;"></image>
            <div class="basket" style="margin-left: {{basketPx}}px;"></div>
          </div>
          <text class="sub">Коронка — двигать корзину</text>
          <text class="stat">{{feedResult}}</text>
        </div>

        <div class="col" if="{{mode === 'train'}}">
          <text class="title">{{trainTitle}}</text>
          <div class="meter-h">
            <div class="target" style="margin-left: {{targetPx}}px; width: {{targetWpx}}px;"></div>
            <div class="needle" style="margin-left: {{needlePx}}px;"></div>
          </div>
          <text class="sub">Коронка — держать в зоне</text>
          <text class="stat">{{trainResult}}</text>
        </div>

        <div class="col" if="{{mode === 'race'}}">
          <text class="title">{{raceTitle}}</text>
          <div class="track-row" for="{{runners}}">
            <text class="runner-name">{{$item.name}}</text>
            <div class="lane">
              <div class="runner-dot" style="margin-left: {{$item.px}}px;"></div>
            </div>
          </div>
          <text class="hint">Тап — рывок</text>
        </div>

        <div class="col" if="{{mode === 'result'}}">
          <text class="title-win" if="{{rank === 1}}">ПОБЕДА!</text>
          <text class="title-lose" if="{{rank > 1}}">{{rankText}} место</text>
          <text class="stat">+{{coinsGain}} монет</text>
          <text class="hint">Тап — дальше</text>
        </div>
      </div>

      <div class="menu" if="{{screen !== 'home'}}">
        <text class="menu-title">{{menuTitle}}</text>
        <text class="menu-sub">{{menuSub}}</text>
        <div class="list">
          <div for="{{rows}}" class="{{$item.cls}}">
            <text class="row-text">{{$item.text}}</text>
          </div>
        </div>
        <text class="msg">{{msg}}</text>
        <text class="hint">{{menuHint}}</text>
      </div>

      <scroll id="crown" class="crown" scroll-y="true"
              onscroll="onCrown" onlongpress="onLong">
        <div class="crown-body" onclick="onTap" ontouchstart="onTouch"></div>
      </scroll>

      <div class="mbtns" if="{{screen !== 'home'}}">
        <div class="mbtn" onclick="cursorUp"><text class="nav-txt">▲</text></div>
        <div class="mbtn mbtn-ok" onclick="onTap"><text class="mbtn-txt">ВЫБРАТЬ</text></div>
        <div class="mbtn" onclick="cursorDown"><text class="nav-txt">▼</text></div>
      </div>

      <div class="nav">
        <div class="nav-btn" onclick="navPrev"><text class="nav-txt">‹</text></div>
        <text class="nav-name">{{navName}}</text>
        <div class="nav-btn" onclick="navNext"><text class="nav-txt">›</text></div>
      </div>
    </stack>
  </div>
</template>

<style>
  .page {
    width: 100%;
    height: 100%;
    background-color: #0b3550;
  }
  .stage {
    width: 100%;
    height: 100%;
  }
  .bg {
    width: 100%;
    height: 100%;
  }
  .scene, .menu {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
  }
  .crown {
    width: 100%;
    height: 100%;
  }
  .crown-body {
    width: 100%;
    height: 6000px;
  }

  .col {
    width: 100%;
    flex-direction: column;
    align-items: center;
    margin-top: 18px;
  }
  .title {
    font-size: 28px;
    color: #ffffff;
    text-align: center;
  }
  .title-win {
    font-size: 32px;
    color: #2ecc71;
  }
  .title-lose {
    font-size: 28px;
    color: #e67e5a;
  }
  .duck-img {
    width: 140px;
    height: 117px;
    margin-top: 6px;
  }
  .hungerline {
    font-size: 18px;
    color: #7fe3ff;
    margin-top: 6px;
  }
  .stats {
    font-size: 18px;
    color: #ffd166;
    margin-top: 6px;
    text-align: center;
  }
  .sub {
    font-size: 18px;
    color: #cfe8f7;
    margin-top: 6px;
    text-align: center;
  }
  .stat {
    font-size: 18px;
    color: #ffd166;
    margin-top: 8px;
    text-align: center;
  }
  .hint {
    font-size: 16px;
    color: #9fc6dd;
    margin-top: 4px;
    text-align: center;
  }

  .feedbox {
    width: 380px;
    height: 180px;
    margin-top: 10px;
    border-radius: 14px;
    background-color: rgba(8, 35, 56, 0.6);
  }
  .falling {
    position: absolute;
    width: 24px;
    height: 24px;
  }
  .basket {
    position: absolute;
    margin-top: 150px;
    width: 60px;
    height: 20px;
    border-radius: 10px;
    background-color: #c89660;
  }

  .meter-h {
    width: 320px;
    height: 32px;
    margin-top: 16px;
    border-radius: 16px;
    background-color: #082338;
  }
  .target {
    position: absolute;
    height: 32px;
    border-radius: 16px;
    background-color: #2e9e68;
  }
  .needle {
    position: absolute;
    width: 6px;
    height: 32px;
    border-radius: 3px;
    background-color: #ffd166;
  }

  .track-row {
    width: 400px;
    flex-direction: column;
    margin-top: 4px;
  }
  .runner-name {
    font-size: 14px;
    color: #cfe8f7;
    margin-top: 4px;
  }
  .lane {
    width: 400px;
    height: 14px;
    border-radius: 7px;
    background-color: #082338;
  }
  .runner-dot {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: #ffd166;
  }

  .menu {
    padding-top: 20px;
    background-color: rgba(4, 18, 30, 0.82);
  }
  .menu-title {
    font-size: 24px;
    color: #ffffff;
  }
  .menu-sub {
    font-size: 16px;
    color: #ffd166;
  }
  .list {
    width: 100%;
    flex-direction: column;
    align-items: center;
    margin-top: 8px;
  }
  .row {
    width: 380px;
    height: 34px;
    margin-top: 4px;
    padding-left: 12px;
    border-radius: 10px;
    background-color: #123a55;
    justify-content: center;
  }
  .row-sel {
    background-color: #2b8fc4;
  }
  .row-text {
    font-size: 16px;
    color: #ffffff;
  }
  .msg {
    font-size: 16px;
    color: #ffd166;
    margin-top: 6px;
    text-align: center;
  }

  .nav {
    position: absolute;
    bottom: 0px;
    left: 0px;
    width: 100%;
    height: 48px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 30px;
    padding-right: 30px;
  }
  .nav-btn {
    width: 56px;
    height: 40px;
    border-radius: 20px;
    background-color: rgba(18, 58, 85, 0.9);
    justify-content: center;
    align-items: center;
  }
  .nav-txt {
    font-size: 24px;
    color: #ffffff;
  }
  .nav-name {
    font-size: 15px;
    color: #cfe8f7;
  }
  .mbtns {
    position: absolute;
    bottom: 54px;
    left: 0px;
    width: 100%;
    height: 38px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 30px;
    padding-right: 30px;
  }
  .mbtn {
    width: 62px;
    height: 38px;
    border-radius: 19px;
    background-color: rgba(18, 58, 85, 0.9);
    justify-content: center;
    align-items: center;
  }
  .mbtn-ok {
    width: 140px;
    background-color: #2b8fc4;
  }
  .mbtn-txt {
    font-size: 15px;
    color: #ffffff;
  }
</style>

<script>
import vibrator from '@system.vibrator'
import storage from '@system.storage'
import game from '../common/game.js'

const SAVE_KEY = 'duckgame_v1'
const SCREENS = ['home', 'shop', 'items', 'locs']
const MENU_STEP = 30
const CENTER = 3000
const RECENTER_AT = 1800
const TICK_MS = 40
const TRACK_PX = 380
const FEED_BOX_PX = 380

function clamp(v, a, b) { return v < a ? a : (v > b ? b : v) }

export default {
  private: {
    screen: 'home',
    mode: 'menu',
    navName: 'ДОМ',
    bgSrc: '',
    duckSrc: '',
    hungerPct: 100,
    spd: 1, pow: 1, sta: 1,
    foodItems: [],
    basketPx: 0,
    feedResult: '',
    trainTitle: '',
    needlePx: 0,
    targetPx: 0,
    targetWpx: 0,
    trainResult: '',
    raceTitle: '',
    runners: [],
    rank: 0,
    rankText: '',
    coinsGain: 0,
    rows: [],
    msg: '',
    menuTitle: '',
    menuSub: '',
    menuHint: ''
  },

  onInit() {
    this.save = game.defaultSave()
    this.timer = null
    this.lastY = CENTER
    this.recentering = false
    this.cursor = 0
    this.acc = 0
    this.msgTimer = null
    this.longPressTimer = null
    this.loadSave()
  },

  onShow() {
    this.recenter()
    if (this.timer === null) this.timer = setInterval(() => this.loop(), TICK_MS)
  },

  onHide() { this.stopLoop() },
  onDestroy() { this.stopLoop() },

  stopLoop() {
    if (this.timer !== null) { clearInterval(this.timer); this.timer = null }
  },

  buzz(mode) {
    try { vibrator.vibrate({ mode: mode }) } catch (err) { /* без вибрации */ }
  },

  // ---------- ввод ----------

  onCrown(e) {
    let y = e && typeof e.scrollY === 'number' ? e.scrollY : (e && e.scrollTop)
    if (typeof y !== 'number' || isNaN(y)) return
    if (this.recentering) { this.recentering = false; this.lastY = y; return }
    const d = y - this.lastY
    this.lastY = y
    if (d !== 0) {
      if (this.screen === 'home' && this.mode === 'train' && this.t) {
        game.trainCrown(this.t, d)
      } else if (this.screen === 'home' && this.mode === 'feed' && this.f) {
        game.feedCrown(this.f, d)
      } else if (this.screen !== 'home') {
        this.moveCursor(d)
      }
    }
    if (Math.abs(y - CENTER) > RECENTER_AT) this.recenter()
  },

  onLong() {
    if (this.screen === 'home' && this.mode === 'menu') this.startTrainPicker()
  },
  onTouch() { /* резерв */ },

  onTap() {
    if (this.screen !== 'home') { this.activate(); return }
    if (this.mode === 'menu') { this.startFeed(); return }
    if (this.mode === 'race' && this.r) { game.raceBoost(this.r); this.buzz('short') }
    if (this.mode === 'result') { this.mode = 'menu'; this.applyBg() }
  },

  cursorUp() { this.stepCursor(-1) },
  cursorDown() { this.stepCursor(1) },
  stepCursor(n) {
    const len = this.menuList().length
    this.cursor = clamp(this.cursor + n, 0, Math.max(0, len - 1))
    this.renderMenus()
  },
  moveCursor(d) {
    if (!isFinite(d)) return
    this.acc += d
    const steps = Math.trunc(this.acc / MENU_STEP)
    if (steps === 0) return
    this.acc -= steps * MENU_STEP
    this.cursor = clamp(this.cursor + steps, 0, this.menuList().length - 1)
    this.renderMenus()
  },

  navPrev() { this.navTo(-1) },
  navNext() { this.navTo(1) },
  navTo(dir) {
    if (this.screen === 'home' && this.mode !== 'menu' && this.mode !== 'result') {
      this.msg = 'Сначала закончите'
      return
    }
    const i = SCREENS.indexOf(this.screen)
    this.setScreen(SCREENS[(i + dir + SCREENS.length) % SCREENS.length])
  },

  setScreen(s) {
    this.screen = s
    const names = { home: 'ДОМ', shop: 'УТКИ', items: 'ВЕЩИ', locs: 'ЛОКАЦИИ' }
    this.navName = names[s]
    this.cursor = 0
    this.acc = 0
    this.msg = ''
    if (s === 'home') { this.mode = 'menu'; this.applyBg(); this.syncStats() }
    else this.renderMenus()
  },

  // Тап на ДОМе — кормление. Долгий тап — тренировка (по кругу: скорость/сила/выносливость).
  startFeed() {
    this.mode = 'feed'
    this.feedResult = ''
    this.f = game.startFeeding(Math.random)
  },

  startTrainPicker() {
    if (!game.canTrain(this.save)) {
      this.msg = 'Утка голодна — сначала покормите'
      this.flashMsg()
      return
    }
    const order = ['speed', 'power', 'stamina']
    const kind = order[(order.indexOf(this.lastTrainKind || 'stamina') + 1) % order.length]
    this.lastTrainKind = kind
    const names = { speed: 'СКОРОСТЬ', power: 'СИЛА', stamina: 'ВЫНОСЛИВОСТЬ' }
    this.mode = 'train'
    this.trainTitle = 'Тренировка: ' + names[kind]
    this.trainResult = ''
    this.t = game.startTraining(Math.random, kind)
  },

  activate() {
    const list = this.menuList()
    const it = list[this.cursor]
    if (!it) return
    if (it.cat === 'race') { this.startRaceOn(it.id); return }
    this.msg = game.buy(this.save, it.cat, it.id)
    this.persist()
    this.renderMenus()
    this.flashMsg()
  },

  startRaceOn(locId) {
    this.save.eq.loc = locId
    this.persist()
    this.screen = 'home'
    this.mode = 'race'
    const loc = game.gear(this.save).loc
    this.raceTitle = loc.name
    this.r = game.startRace(Math.random, this.save)
    this.applyBg()
  },

  flashMsg() {
    if (this.msgTimer) clearTimeout(this.msgTimer)
    this.msgTimer = setTimeout(() => { this.msg = '' }, 2200)
  },

  // ---------- меню ----------

  menuList() {
    if (this.screen === 'shop') return game.shopItems(this.save, 'duck')
    if (this.screen === 'items') return game.shopItems(this.save, 'item')
    if (this.screen === 'locs') {
      return game.LOCATIONS.map(t => ({
        cat: 'race', id: t.id, name: t.name, price: t.price,
        owned: this.save.owned.loc.indexOf(t.id) >= 0
      }))
    }
    return []
  },

  renderMenus() {
    const coinsText = 'Монеты: ' + this.save.coins
    if (this.screen === 'shop') { this.menuTitle = 'УТКИ'; this.menuHint = 'ВЫБРАТЬ — купить/выбрать' }
    else if (this.screen === 'items') { this.menuTitle = 'ВЕЩИ'; this.menuHint = 'Постоянный бонус к характеристике' }
    else { this.menuTitle = 'ЛОКАЦИИ'; this.menuHint = 'ВЫБРАТЬ — купить или бежать' }
    this.menuSub = coinsText

    const list = this.menuList()
    const start = clamp(this.cursor - 1, 0, Math.max(0, list.length - 4))
    const rows = []
    for (let i = start; i < list.length && rows.length < 4; i++) {
      const it = list[i]
      const mark = it.owned ? (it.equipped ? '● ' : (it.cat === 'race' ? '✓ ' : '○ ')) : ''
      let tail
      if (it.cat === 'race') tail = it.owned ? 'бежать' : it.price + ' монет'
      else tail = it.owned ? (it.equipped ? 'надето' : 'есть') : it.price + ' монет'
      rows.push({ text: mark + it.name + ' — ' + tail, cls: 'row' + (i === this.cursor ? ' row-sel' : '') })
    }
    this.rows = rows
  },

  applyBg() {
    const g = game.gear(this.save)
    this.bgSrc = '/common/img/bg_' + g.loc.id + '.png'
    this.duckSrc = '/common/img/duck_' + g.duck.id + '.png'
  },

  syncStats() {
    this.spd = game.effectiveStat(this.save, 'speed')
    this.pow = game.effectiveStat(this.save, 'power')
    this.sta = game.effectiveStat(this.save, 'stamina')
    this.hungerPct = Math.round(this.save.duck.hunger)
  },

  // ---------- игровой цикл ----------

  recenter() {
    const el = this.$element('crown')
    if (!el) return
    this.recentering = true
    this.lastY = CENTER
    el.scrollTo({ top: CENTER, left: 0, behavior: 'instant' })
  },

  loop() {
    if (this.screen === 'home' && this.mode === 'feed' && this.f) {
      game.feedStep(this.f, TICK_MS / 1000)
      this.foodItems = this.f.items.map(it => ({
        src: it.golden ? '/common/img/food_gold.png' : '/common/img/food.png',
        x: Math.round(it.x / 100 * FEED_BOX_PX),
        y: Math.round(it.y / 100 * 160)
      }))
      const bpx = Math.round(this.f.basket / 100 * FEED_BOX_PX)
      if (this.basketPx !== bpx) this.basketPx = bpx
      if (this.f.done) {
        const res = game.applyFeeding(this.save, this.f)
        this.feedResult = res.stat
          ? ('Сытость +' + res.hunger + ', характеристика +' + res.stat.amount + '!')
          : ('Сытость +' + res.hunger)
        this.persist()
        this.syncStats()
        this.buzz(res.stat ? 'long' : 'short')
        setTimeout(() => { this.mode = 'menu'; this.f = null }, 1200)
      }
    }

    if (this.screen === 'home' && this.mode === 'train' && this.t) {
      game.trainStep(this.t, TICK_MS / 1000)
      const needle = Math.round(this.t.needle / 100 * 320)
      if (this.needlePx !== needle) this.needlePx = needle
      const tpx = Math.round((this.t.target - this.t.targetW / 2) / 100 * 320)
      if (this.targetPx !== tpx) this.targetPx = tpx
      const tw = Math.round(this.t.targetW / 100 * 320)
      if (this.targetWpx !== tw) this.targetWpx = tw
      if (this.t.done) {
        const gained = game.applyTraining(this.save, this.t)
        this.trainResult = gained > 0 ? ('+' + gained + ' к характеристике!') : 'Мимо. Попробуйте ещё раз'
        this.persist()
        this.syncStats()
        this.buzz(gained > 0 ? 'long' : 'short')
        setTimeout(() => { this.mode = 'menu'; this.t = null }, 1200)
      }
    }

    if (this.screen === 'home' && this.mode === 'race' && this.r) {
      game.raceStep(this.r, TICK_MS / 1000)
      this.runners = this.r.runners.map(run => ({
        name: run.name,
        px: Math.round(clamp(run.pos / this.r.length, 0, 1) * TRACK_PX)
      }))
      if (this.r.finished) {
        this.rank = this.r.rank
        this.rankText = this.r.rank === 2 ? '2-е' : (this.r.rank === 3 ? '3-е' : (this.r.rank + '-е'))
        this.coinsGain = game.finishRewards(this.save, this.r, this.save.eq.loc)
        this.persist()
        this.syncStats()
        this.mode = 'result'
        this.buzz(this.rank === 1 ? 'long' : 'short')
        this.r = null
      }
    }
  },

  // ---------- сохранение ----------

  persist() {
    try { storage.set({ key: SAVE_KEY, value: JSON.stringify(this.save) }) }
    catch (err) { console.warn('save failed') }
  },

  loadSave() {
    storage.get({
      key: SAVE_KEY,
      default: '',
      success: (data) => {
        if (data) {
          try { this.save = game.mergeSave(JSON.parse(data)) }
          catch (err) { console.warn('save parse failed') }
        }
        game.applyHungerDecay(this.save, Date.now())
        this.persist()
        this.applyBg()
        this.syncStats()
      }
    })
  }
}
</script>
