<template>
  <div class="page">
    <stack class="stage">

      <!-- Фон локации -->
      <image class="bg" src="{{bgSrc}}"></image>

      <!-- ===== Экран ловли ===== -->
      <div class="scene" if="{{screen === 'fish'}}">
        <div class="hud">
          <text class="hud-coins">{{coinsText}}</text>
          <text class="hud-loc">{{locName}}{{streakText}}</text>
        </div>

        <div class="col" if="{{state === 'idle'}}">
          <text class="title">РЫБАЛКА</text>
          <text class="sub">Дальность: {{powerText}}</text>
          <div class="bar">
            <div class="bar-fill" style="width: {{powerPx}}px;"></div>
          </div>
          <text class="hint">Коронка — дальность</text>
          <text class="hint">Тап{{castHint}} — забросить, два тапа — дальний</text>
          <text class="hint">Свайп ← → — меню</text>
          <text class="stat" if="{{bestText}}">Рекорд: {{bestText}}</text>
        </div>

        <div class="col" if="{{state === 'casting' || state === 'wait' || state === 'bite'}}">
          <text class="alert" if="{{state === 'bite'}}">ПОКЛЁВКА!</text>
          <text class="title" if="{{state !== 'bite'}}">Ждём...</text>
          <div class="pond">
            <div class="bobber" style="margin-top: {{bobY}}px;"></div>
          </div>
          <text class="hint" if="{{state === 'wait'}}">Не спеши</text>
          <text class="hint-hot" if="{{state === 'bite'}}">Тап{{hookHint}} — подсечь</text>
        </div>

        <div class="col" if="{{state === 'fight'}}">
          <text class="sub">{{fightTitle}}</text>
          <text class="hint">{{fightHint}}</text>
          <div class="fight-row">
            <stack class="track">
              <div class="zone" style="margin-top: {{zoneY}}px; height: {{zoneH}}px;"></div>
              <image class="fish-img" src="{{fishSrc}}" style="margin-top: {{fishY}}px;"></image>
            </stack>
            <div class="meter">
              <div class="meter-fill" style="height: {{progressPx}}px;"></div>
            </div>
          </div>
        </div>

        <div class="col" if="{{state === 'result'}}">
          <image class="res-img" src="{{resSrc}}"></image>
          <text class="title-rare" if="{{rare}}">РЕДКАЯ РЫБА!</text>
          <text class="title-win" if="{{won && !rare}}">Поймал!</text>
          <text class="title-lose" if="{{!won}}">Не повезло</text>
          <text class="big">{{resTitle}}</text>
          <text class="sub">{{resLine}}</text>
          <text class="stat" if="{{gain > 0}}">+{{gain}} монет{{bonusText}}</text>
          <text class="new-tag" if="{{isNew}}">Новый вид в коллекции!</text>
          <text class="hint">Тап — дальше</text>
        </div>
      </div>

      <!-- ===== Меню: магазин, места, настройки ===== -->
      <div class="menu" if="{{screen !== 'fish'}}">
        <text class="menu-title">{{menuTitle}}</text>
        <text class="menu-sub">{{menuSub}}</text>
        <div class="list">
          <div for="{{rows}}" class="{{$item.cls}}">
            <text class="row-text">{{$item.text}}</text>
          </div>
        </div>
        <text class="msg">{{msg}}</text>
        <text class="hint">{{menuHint}}</text>
      </div>

      <!-- Прозрачный слой: коронка, свайпы, тапы, долгое нажатие -->
      <scroll id="crown" class="crown" scroll-y="true"
              onscroll="onCrown" onswipe="onSwipe" onlongpress="onLong">
        <div class="crown-body" onclick="onTap" ontouchstart="onTouch"></div>
      </scroll>

      <!-- Кнопки переключения экранов (не зависят от свайпа) -->
      <div class="nav">
        <div class="nav-btn" onclick="navPrev"><text class="nav-txt">‹</text></div>
        <text class="nav-name">{{navName}}</text>
        <div class="nav-btn" onclick="navNext"><text class="nav-txt">›</text></div>
      </div>

    </stack>
  </div>
</template>

<style>
  .page {
    width: 100%;
    height: 100%;
    background-color: #0b3550;
  }
  .stage {
    width: 100%;
    height: 100%;
  }
  .bg {
    width: 100%;
    height: 100%;
  }
  .scene, .menu {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
  }
  .crown {
    width: 100%;
    height: 100%;
  }
  .crown-body {
    width: 100%;
    height: 6000px;
  }

  .hud {
    margin-top: 40px;
    width: 100%;
    flex-direction: column;
    align-items: center;
  }
  .hud-coins {
    font-size: 26px;
    color: #ffd166;
  }
  .hud-loc {
    font-size: 20px;
    color: #cfe8f7;
  }

  .col {
    width: 100%;
    flex-direction: column;
    align-items: center;
    margin-top: 8px;
  }
  .title {
    font-size: 40px;
    color: #ffffff;
    margin-top: 8px;
  }
  .title-win {
    font-size: 38px;
    color: #2ecc71;
    margin-top: 6px;
  }
  .title-rare {
    font-size: 36px;
    color: #ffd166;
    margin-top: 6px;
  }
  .title-lose {
    font-size: 38px;
    color: #e67e5a;
    margin-top: 6px;
  }
  .alert {
    font-size: 44px;
    color: #ff5a4f;
    margin-top: 8px;
  }
  .sub {
    font-size: 24px;
    color: #cfe8f7;
    margin-top: 6px;
    text-align: center;
  }
  .big {
    font-size: 34px;
    color: #ffffff;
    margin-top: 6px;
    text-align: center;
  }
  .stat {
    font-size: 22px;
    color: #ffd166;
    margin-top: 8px;
    text-align: center;
  }
  .new-tag {
    font-size: 20px;
    color: #7fe3ff;
    margin-top: 4px;
    text-align: center;
  }
  .hint {
    font-size: 20px;
    color: #9fc6dd;
    margin-top: 6px;
    text-align: center;
  }
  .hint-hot {
    font-size: 22px;
    color: #ffd166;
    margin-top: 6px;
    text-align: center;
  }

  .bar {
    width: 280px;
    height: 22px;
    margin-top: 12px;
    border-radius: 11px;
    background-color: #082338;
  }
  .bar-fill {
    height: 22px;
    border-radius: 11px;
    background-color: #29b6f6;
  }

  .pond {
    width: 300px;
    height: 150px;
    margin-top: 10px;
    border-radius: 24px;
    background-color: #14649a;
    justify-content: center;
  }
  .bobber {
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background-color: #ff5a4f;
  }

  .fight-row {
    margin-top: 8px;
    align-items: flex-start;
    justify-content: center;
  }
  .track {
    width: 140px;
    height: 300px;
    border-radius: 14px;
    background-color: #082338;
  }
  .zone {
    width: 140px;
    border-radius: 14px;
    background-color: #2e9e68;
  }
  .fish-img {
    width: 120px;
    height: 60px;
    margin-left: 10px;
  }
  .meter {
    width: 30px;
    height: 300px;
    margin-left: 22px;
    border-radius: 15px;
    background-color: #082338;
    flex-direction: column;
    justify-content: flex-end;
  }
  .meter-fill {
    width: 30px;
    border-radius: 15px;
    background-color: #ffd166;
  }
  .res-img {
    width: 150px;
    height: 75px;
  }

  .menu {
    padding-top: 36px;
    background-color: rgba(4, 18, 30, 0.82);
  }
  .menu-title {
    font-size: 30px;
    color: #ffffff;
  }
  .menu-sub {
    font-size: 20px;
    color: #ffd166;
    margin-top: 2px;
  }
  .list {
    width: 100%;
    flex-direction: column;
    align-items: center;
    margin-top: 10px;
  }
  .row {
    width: 340px;
    height: 40px;
    margin-top: 4px;
    padding-left: 12px;
    border-radius: 10px;
    background-color: #123a55;
    justify-content: center;
  }
  .row-sel {
    background-color: #2b8fc4;
  }
  .row-text {
    font-size: 20px;
    color: #ffffff;
  }
  .nav {
    position: absolute;
    bottom: 0px;
    left: 0px;
    width: 100%;
    height: 56px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 30px;
    padding-right: 30px;
  }
  .nav-btn {
    width: 60px;
    height: 46px;
    border-radius: 23px;
    background-color: rgba(18, 58, 85, 0.9);
    justify-content: center;
    align-items: center;
  }
  .nav-txt {
    font-size: 30px;
    color: #ffffff;
  }
  .nav-name {
    font-size: 18px;
    color: #cfe8f7;
  }
  .msg {
    font-size: 20px;
    color: #ffd166;
    margin-top: 8px;
    text-align: center;
  }
</style>

<script>
import vibrator from '@system.vibrator'
import storage from '@system.storage'
import sensor from '@system.sensor'
import audio from '@system.audio'
import game from '../common/game.js'

const SAVE_KEY = 'fishing_v2'
const MENU_STEP = 30            // сколько прокрутки на одну строку меню
const CENTER = 3000
const RECENTER_AT = 1800
const TICK_MS = 40
const DOUBLE_TAP_MS = 350
const SCREENS = ['fish', 'shop', 'map', 'settings']
const VOLUMES = [0, 25, 50, 75, 100]

const MUSIC = {
  calm: '/common/snd/music_calm.mp3',
  upbeat: '/common/snd/music_upbeat.mp3'
}
const SFX = {
  cast: '/common/snd/sfx_cast.mp3',
  bite: '/common/snd/sfx_bite.mp3',
  hook: '/common/snd/sfx_hook.mp3',
  win: '/common/snd/sfx_win.mp3',
  coin: '/common/snd/sfx_coin.mp3',
  lose: '/common/snd/sfx_lose.mp3',
  rare: '/common/snd/sfx_rare.mp3'
}

function clamp(v, a, b) { return v < a ? a : (v > b ? b : v) }
function onOff(v) { return v ? 'вкл' : 'выкл' }

export default {
  private: {
    screen: 'fish',
    state: 'idle',
    coinsText: '',
    menuSub: '',
    locName: '',
    navName: 'РЫБАЛКА',
    streakText: '',
    bgSrc: '',
    powerPx: 140,
    powerText: 'Средне',
    bobY: 40,
    zoneY: 0,
    zoneH: 120,
    fishY: 0,
    fishSrc: '',
    fightTitle: 'Держи рыбу в зоне',
    fightHint: 'Долгое нажатие — отпустить',
    progressPx: 90,
    resSrc: '',
    resTitle: '',
    resLine: '',
    won: false,
    rare: false,
    isNew: false,
    gain: 0,
    bonusText: '',
    bestText: '',
    castHint: '',
    hookHint: '',
    rows: [],
    msg: '',
    menuTitle: '',
    menuHint: ''
  },

  onInit() {
    this.save = game.defaultSave()
    this.g = game.create(Math.random, this.save)
    this.timer = null
    this.lastY = CENTER
    this.recentering = false
    this.tick = 0
    this.lastTouchTick = -1000
    this.lastTapAt = 0
    this.cursor = 0
    this.acc = 0
    this.msgTimer = null
    this.sensorOn = false
    this.track = ''
    this.motion = game.motionNew()
    this.loadSave()
  },

  onShow() {
    this.recenter()
    if (this.timer === null) {
      this.timer = setInterval(() => this.loop(), TICK_MS)
    }
    this.startSensor()
    this.playMusic(this.locMusic())
  },

  onHide() {
    this.stopLoop()
    this.stopSensor()
    this.pauseMusic()
  },

  onDestroy() {
    this.stopLoop()
    this.stopSensor()
    this.pauseMusic()
  },

  stopLoop() {
    if (this.timer !== null) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  // ---------- звук ----------

  musicVolume() { return this.save.settings.musicVol / 100 },

  locMusic() { return game.gear(this.g).loc.music },

  playMusic(track) {
    this.track = track
    if (this.save.settings.musicVol === 0) {
      this.pauseMusic()
      return
    }
    try {
      audio.src = MUSIC[track]
      audio.loop = true
      audio.volume = this.musicVolume()
      audio.play()
    } catch (err) {
      console.warn('music failed')
    }
  },

  pauseMusic() {
    try { audio.pause() } catch (err) { /* нет звука — играем без него */ }
  },

  // Эффект прерывает музыку (один плеер на часах), потом музыка продолжается с того же места
  playSfx(name) {
    if (!this.save.settings.sfx || !SFX[name]) return
    let resumeAt = 0
    try { resumeAt = audio.currentTime || 0 } catch (err) { resumeAt = 0 }
    try {
      audio.onended = null
      audio.loop = false
      audio.src = SFX[name]
      audio.volume = Math.min(0.6, 0.3 + this.musicVolume() * 0.3)
      audio.onended = () => {
        audio.onended = null
        this.resumeMusic(resumeAt)
      }
      audio.play()
    } catch (err) {
      console.warn('sfx failed')
    }
  },

  resumeMusic(at) {
    if (!this.track || this.save.settings.musicVol === 0) return
    try {
      audio.src = MUSIC[this.track]
      audio.loop = true
      audio.volume = this.musicVolume()
      audio.currentTime = at
      audio.play()
    } catch (err) {
      console.warn('music resume failed')
    }
  },

  buzz(mode) {
    if (!this.save.settings.vib) return
    try { vibrator.vibrate({ mode: mode }) } catch (err) { /* без вибрации */ }
  },

  // ---------- датчики ----------

  startSensor() {
    if (this.sensorOn || !this.save.settings.motion) return
    this.motion = game.motionNew()
    try {
      sensor.subscribeAccelerometer({
        interval: 'game',
        callback: (d) => this.onAccel(d),
        fail: () => this.sensorFailed()
      })
      this.sensorOn = true
    } catch (err) {
      this.sensorFailed()
    }
  },

  stopSensor() {
    if (!this.sensorOn) return
    try {
      sensor.unsubscribeAccelerometer()
    } catch (err) {
      console.warn('sensor stop failed')
    }
    this.sensorOn = false
  },

  // Датчик недоступен (официально — не на всех часах): выключаем управление движением
  sensorFailed() {
    this.sensorOn = false
    this.sensorBad = true
    this.save.settings.motion = false
    this.msg = 'Датчик движения недоступен на этих часах'
    this.flashMsg()
    this.persist()
    this.updateHints()
    if (this.screen !== 'fish') this.renderMenus()
  },

  onAccel(d) {
    const s = this.save.settings
    if (!s.motion || this.screen !== 'fish') return
    const t = this.tick * TICK_MS / 1000
    const ev = game.motionFeed(this.motion, d.x, d.y, d.z, t)
    const g = this.g
    if (ev.flick && ((g.state === 'idle' && s.castFlick) || (g.state === 'bite' && s.hookFlick))) {
      this.doTap()
      return
    }
    if (s.tilt && g.state === 'fight' && ev.tilt !== 0) {
      game.tilt(g, ev.tilt * game.SENS[s.sens], TICK_MS / 1000)
    }
  },

  updateHints() {
    const s = this.save.settings
    this.castHint = s.motion && s.castFlick ? ' или взмах' : ''
    this.hookHint = s.motion && s.hookFlick ? ' или рывок' : ''
    this.fightHint = s.motion && s.tilt
      ? 'Наклон — двигать зону. Долгое нажатие — отпустить'
      : 'Долгое нажатие — отпустить'
  },

  // ---------- ввод ----------

  onCrown(e) {
    const y = e.scrollY
    if (this.recentering) {
      this.recentering = false
      this.lastY = y
      return
    }
    const d = y - this.lastY
    this.lastY = y

    if (d !== 0) {
      if (this.screen === 'fish') {
        game.crown(this.g, d * game.SENS[this.save.settings.sens])
      } else {
        this.moveCursor(d)
      }
    }
    if (Math.abs(y - CENTER) > RECENTER_AT) this.recenter()
  },

  // Свайп влево/вправо переключает экраны. Во время заброса и боя не работает.
  onSwipe(e) {
    if (this.g.state !== 'idle' && this.g.state !== 'result') return
    const i = SCREENS.indexOf(this.screen)
    if (e.direction === 'left') this.setScreen(SCREENS[(i + 1) % SCREENS.length])
    else if (e.direction === 'right') this.setScreen(SCREENS[(i + SCREENS.length - 1) % SCREENS.length])
  },

  onLong() {
    if (this.screen === 'fish') {
      game.longpress(this.g)
      this.sync()
    }
  },

  onTouch() {
    this.lastTouchTick = this.tick
  },

  onTap() {
    if (this.screen !== 'fish') {
      this.activate()
      return
    }
    const now = Date.now()
    const quick = now - this.lastTapAt < DOUBLE_TAP_MS
    this.lastTapAt = quick ? 0 : now
    // Двойной тап в простое — заброс на полную дальность
    if (quick && this.g.state === 'idle') this.g.power = 100
    this.doTap()
  },

  doTap() {
    game.tap(this.g)
    this.sync()
  },

  // Кнопки ‹ › внизу: переход между экранами по нажатию
  navPrev() { this.navTo(-1) },
  navNext() { this.navTo(1) },

  navTo(dir) {
    if (this.screen === 'fish' && this.g.state !== 'idle' && this.g.state !== 'result') {
      this.msg = 'Сначала доиграйте рыбалку'
      this.flashMsg()
      return
    }
    const i = SCREENS.indexOf(this.screen)
    this.setScreen(SCREENS[(i + dir + SCREENS.length) % SCREENS.length])
  },

  setScreen(s) {
    this.screen = s
    const names = { fish: 'РЫБАЛКА', shop: 'МАГАЗИН', map: 'МЕСТА', settings: 'НАСТРОЙКИ' }
    this.navName = names[s]
    this.cursor = 0
    this.acc = 0
    this.msg = ''
    if (s === 'fish') {
      this.applyBg()
      this.sync()
    } else {
      this.renderMenus()
    }
  },

  moveCursor(d) {
    this.acc += d
    const steps = Math.trunc(this.acc / MENU_STEP)
    if (steps === 0) return
    this.acc -= steps * MENU_STEP
    this.cursor = clamp(this.cursor + steps, 0, this.menuList().length - 1)
    this.renderMenus()
  },

  // Тап в меню: купить / надеть вещь, выбрать место или переключить настройку
  activate() {
    const list = this.menuList()
    const it = list[this.cursor]
    if (!it) return
    if (it.cat === 'set') {
      this.toggleSetting(it.id)
    } else {
      this.msg = game.buy(this.save, it.cat, it.id)
      this.persist()
      this.applyBg()
    }
    this.renderMenus()
    this.flashMsg()
  },

  toggleSetting(id) {
    const s = this.save.settings
    if (id === 'motion' && this.sensorBad) {
      this.msg = 'Датчик недоступен на этих часах'
      return
    }
    if (id === 'sens') {
      s.sens = (s.sens + 1) % game.SENS.length
    } else if (id === 'musicVol') {
      s.musicVol = VOLUMES[(VOLUMES.indexOf(s.musicVol) + 1) % VOLUMES.length]
      this.playMusic(this.track || this.locMusic())
    } else {
      s[id] = !s[id]
    }
    this.persist()
    this.updateHints()
    if (id === 'motion') {
      if (s.motion) this.startSensor()
      else this.stopSensor()
    }
    this.msg = id === 'motion' && s.motion && !this.sensorOn ? this.msg : 'Сохранено'
  },

  flashMsg() {
    if (this.msgTimer) clearTimeout(this.msgTimer)
    this.msgTimer = setTimeout(() => { this.msg = '' }, 2500)
  },

  // ---------- меню ----------

  menuList() {
    if (this.screen === 'shop') {
      return game.shopItems(this.save, 'rod')
        .concat(game.shopItems(this.save, 'reel'), game.shopItems(this.save, 'bait'))
    }
    if (this.screen === 'settings') {
      const s = this.save.settings
      return [
        { cat: 'set', id: 'motion', label: 'Датчики движения: ' + (this.sensorBad ? 'недоступны' : onOff(s.motion)) },
        { cat: 'set', id: 'castFlick', label: 'Заброс взмахом: ' + onOff(s.castFlick) },
        { cat: 'set', id: 'hookFlick', label: 'Подсечка рывком: ' + onOff(s.hookFlick) },
        { cat: 'set', id: 'tilt', label: 'Балансир (наклон): ' + onOff(s.tilt) },
        { cat: 'set', id: 'sens', label: 'Коронка: ' + game.SENS_NAMES[s.sens] },
        { cat: 'set', id: 'musicVol', label: 'Громкость музыки: ' + (s.musicVol === 0 ? 'выкл' : s.musicVol + '%') },
        { cat: 'set', id: 'sfx', label: 'Звуковые эффекты: ' + onOff(s.sfx) },
        { cat: 'set', id: 'vib', label: 'Вибрация: ' + onOff(s.vib) }
      ]
    }
    return game.LOCATIONS.map(loc => ({
      cat: 'loc',
      id: loc.id,
      name: loc.name,
      price: loc.price,
      owned: this.save.owned.loc.indexOf(loc.id) >= 0,
      equipped: this.save.eq.loc === loc.id
    }))
  },

  collectionText() {
    const total = Object.keys(game.FISH).filter(id => !game.FISH[id].junk).length
    return 'Коллекция: ' + this.save.stats.seen.length + '/' + total
  },

  renderMenus() {
    this.coinsText = 'Монеты: ' + this.save.coins
    if (this.screen === 'shop') {
      this.menuTitle = 'МАГАЗИН'
      this.menuHint = 'Коронка — выбор, тап — купить или надеть'
      this.menuSub = this.coinsText
    } else if (this.screen === 'map') {
      this.menuTitle = 'МЕСТА'
      this.menuHint = 'Коронка — выбор, тап — купить или перейти'
      this.menuSub = this.coinsText + '   ' + this.collectionText()
    } else {
      this.menuTitle = 'НАСТРОЙКИ'
      this.menuHint = 'Тап — переключить. Датчики есть не на всех часах'
      this.menuSub = ''
    }

    const list = this.menuList()
    const start = clamp(this.cursor - 1, 0, Math.max(0, list.length - 4))
    const rows = []
    for (let i = start; i < list.length && rows.length < 4; i++) {
      const it = list[i]
      let text = it.label
      if (!text) {
        const mark = it.owned ? (it.equipped ? '● ' : '○ ') : ''
        const tail = it.owned ? (it.equipped ? 'надето' : 'есть') : (it.price + ' монет')
        text = mark + it.name + ' — ' + tail
      }
      rows.push({ text: text, cls: 'row' + (i === this.cursor ? ' row-sel' : '') })
    }
    this.rows = rows
    const cur = list[this.cursor]
    if (cur) this.menuHint = this.actionHint(cur) + '   ·   коронка — выбор'
  },

  // Что сделает тап по выделенной строке
  actionHint(it) {
    if (it.cat === 'set') return 'Тап — переключить'
    if (it.cat === 'loc') return it.owned ? 'Тап — перейти' : 'Тап — купить за ' + it.price
    return it.owned ? (it.equipped ? 'Уже надето' : 'Тап — надеть') : 'Тап — купить за ' + it.price
  },

  applyBg() {
    const loc = game.gear(this.g).loc
    this.bgSrc = '/common/img/bg_' + loc.id + '.png'
    this.locName = loc.name
    if (loc.music !== this.track) this.playMusic(loc.music)
  },

  // ---------- игровой цикл ----------

  recenter() {
    const el = this.$element('crown')
    if (!el) return
    this.recentering = true
    this.lastY = CENTER
    el.scrollTo({ top: CENTER, left: 0, behavior: 'instant' })
  },

  loop() {
    this.tick += 1
    game.step(this.g, TICK_MS / 1000)
    this.sync()
  },

  sync() {
    const g = this.g

    while (g.events.length) {
      const ev = g.events.shift()
      if (ev === 'bite') { this.buzz('long'); this.playSfx('bite') }
      else if (ev === 'hook') { this.buzz('short'); this.playSfx('hook') }
      else if (ev === 'lose') { this.buzz('short'); this.playSfx('lose') }
      else if (ev === 'win') { this.buzz('long'); this.playSfx('win') }
      else if (ev === 'rare') { this.buzz('long'); this.playSfx('rare') }
    }

    if (this.state !== g.state) {
      if (g.state === 'casting') this.playSfx('cast')
      this.state = g.state
      this.updateHints()
    }
    this.coinsText = 'Монеты: ' + this.save.coins
    const streak = this.save.stats.streak
    this.streakText = streak > 1 ? '   Серия: ' + streak : ''

    if (g.state === 'idle') {
      const px = Math.round(g.power * 2.8)
      if (this.powerPx !== px) this.powerPx = px
      const t = game.powerLabel(g.power)
      if (this.powerText !== t) this.powerText = t
    }

    if (g.state === 'casting' || g.state === 'wait' || g.state === 'bite') {
      const b = Math.round(g.bobY)
      if (this.bobY !== b) this.bobY = b
    }

    if (g.state === 'fight') {
      const z = Math.round(g.zoneY)
      const f = Math.round(g.fishY)
      const p = Math.round(g.progress * 3)
      if (this.zoneY !== z) this.zoneY = z
      if (this.zoneH !== g.zoneH) this.zoneH = g.zoneH
      if (this.fishY !== f) this.fishY = f
      if (this.progressPx !== p) this.progressPx = p
      const fish = game.FISH[g.fishId]
      const title = fish.rare ? 'Редкая рыба! Держи!' : (g.burstLeft > 0 ? 'Рывок!' : 'Держи рыбу в зоне')
      if (this.fightTitle !== title) this.fightTitle = title
      const src = '/common/img/fish_' + g.fishId + '.png'
      if (this.fishSrc !== src) this.fishSrc = src
    }

    if (g.state === 'result' && g.last) {
      const L = g.last
      if (this.won !== L.won) this.won = L.won
      if (this.rare !== L.rare) this.rare = L.rare
      if (this.isNew !== L.isNew) this.isNew = L.isNew
      if (this.gain !== L.gain) this.gain = L.gain
      const bt = L.bonus > 1 ? '  (×' + L.bonus.toFixed(1) + ' серия)' : ''
      if (this.bonusText !== bt) this.bonusText = bt
      if (this.resTitle !== L.title) this.resTitle = L.title
      if (this.resLine !== L.line) this.resLine = L.line
      const src = '/common/img/fish_' + L.fishId + '.png'
      if (this.resSrc !== src) this.resSrc = src
    }

    const st = this.save.stats
    const best = st.bestKg > 0 ? game.FISH[st.bestId].name + ' ' + st.bestKg + ' кг' : ''
    if (this.bestText !== best) this.bestText = best

    if (g.dirty) {
      g.dirty = false
      this.persist()
    }
  },

  // ---------- сохранение ----------

  persist() {
    try {
      storage.set({ key: SAVE_KEY, value: JSON.stringify(this.save) })
    } catch (err) {
      console.warn('save failed')
    }
  },

  loadSave() {
    storage.get({
      key: SAVE_KEY,
      default: '',
      success: (data) => {
        if (data) {
          try {
            this.save = game.mergeSave(JSON.parse(data))
            this.g.save = this.save
          } catch (err) {
            console.warn('save parse failed')
          }
        }
        this.applyBg()
        this.updateHints()
        this.sync()
        this.renderMenus()
      }
    })
  }
}
</script>
