<template>
  <div class="page">
    <stack class="stage">

      <!-- Фон локации -->
      <image class="bg" src="{{bgSrc}}"></image>

      <!-- ===== Экран 1: ловля ===== -->
      <div class="scene" if="{{screen === 'fish'}}">
        <div class="hud">
          <text class="hud-coins">{{coinsText}}</text>
          <text class="hud-loc">{{locName}}</text>
        </div>

        <div class="col" if="{{state === 'idle'}}">
          <text class="title">РЫБАЛКА</text>
          <text class="sub">Дальность: {{powerText}}</text>
          <div class="bar">
            <div class="bar-fill" style="width: {{powerPx}}px;"></div>
          </div>
          <text class="hint">Коронка — дальность</text>
          <text class="hint">Тап — забросить</text>
          <text class="hint">Свайп влево/вправо — меню</text>
          <text class="stat" if="{{bestText}}">Рекорд: {{bestText}}</text>
        </div>

        <div class="col" if="{{state === 'casting' || state === 'wait' || state === 'bite'}}">
          <text class="alert" if="{{state === 'bite'}}">ПОКЛЁВКА!</text>
          <text class="title" if="{{state !== 'bite'}}">Ждём...</text>
          <div class="pond">
            <div class="bobber" style="margin-top: {{bobY}}px;"></div>
          </div>
          <text class="hint" if="{{state === 'wait'}}">Не спеши</text>
          <text class="hint-hot" if="{{state === 'bite'}}">Тап или крути коронку</text>
        </div>

        <div class="col" if="{{state === 'fight'}}">
          <text class="sub">Держи рыбу в зоне</text>
          <text class="hint">Долгое нажатие — отпустить</text>
          <div class="fight-row">
            <stack class="track">
              <div class="zone" style="margin-top: {{zoneY}}px; height: {{zoneH}}px;"></div>
              <image class="fish-img" src="{{fishSrc}}" style="margin-top: {{fishY}}px;"></image>
            </stack>
            <div class="meter">
              <div class="meter-fill" style="height: {{progressPx}}px;"></div>
            </div>
          </div>
        </div>

        <div class="col" if="{{state === 'result'}}">
          <image class="res-img" src="{{resSrc}}"></image>
          <text class="title-win" if="{{won}}">Поймал!</text>
          <text class="title-lose" if="{{!won}}">Не повезло</text>
          <text class="big">{{resTitle}}</text>
          <text class="sub">{{resLine}}</text>
          <text class="stat" if="{{gain > 0}}">+{{gain}} монет</text>
          <text class="hint">Тап — дальше</text>
        </div>
      </div>

      <!-- ===== Экран 2: магазин ===== -->
      <div class="menu" if="{{screen === 'shop'}}">
        <text class="menu-title">МАГАЗИН</text>
        <text class="menu-sub">{{coinsText}}</text>
        <div class="list">
          <div for="{{rows}}" class="{{$item.cls}}">
            <text class="row-text">{{$item.text}}</text>
          </div>
        </div>
        <text class="msg">{{msg}}</text>
        <text class="hint">Коронка — выбор, тап — купить или надеть</text>
      </div>

      <!-- ===== Экран 3: места ===== -->
      <div class="menu" if="{{screen === 'map'}}">
        <text class="menu-title">МЕСТА</text>
        <text class="menu-sub">{{coinsText}}</text>
        <div class="list">
          <div for="{{rows}}" class="{{$item.cls}}">
            <text class="row-text">{{$item.text}}</text>
          </div>
        </div>
        <text class="msg">{{msg}}</text>
        <text class="hint">Коронка — выбор, тап — купить или перейти</text>
      </div>

      <!-- Прозрачный слой: ловит коронку, свайпы, тапы и долгое нажатие -->
      <scroll id="crown" class="crown" scroll-y="true"
              onscroll="onCrown" onswipe="onSwipe" onlongpress="onLong">
        <div class="crown-body" onclick="onTap" ontouchstart="onTouch"></div>
      </scroll>

    </stack>
  </div>
</template>

<style>
  .page {
    width: 100%;
    height: 100%;
    background-color: #0b3550;
  }
  .stage {
    width: 100%;
    height: 100%;
  }
  .bg {
    width: 100%;
    height: 100%;
  }
  .scene, .menu {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
  }
  .crown {
    width: 100%;
    height: 100%;
  }
  .crown-body {
    width: 100%;
    height: 6000px;
  }

  .hud {
    margin-top: 40px;
    width: 100%;
    flex-direction: column;
    align-items: center;
  }
  .hud-coins {
    font-size: 26px;
    color: #ffd166;
  }
  .hud-loc {
    font-size: 20px;
    color: #cfe8f7;
  }

  .col {
    width: 100%;
    flex-direction: column;
    align-items: center;
    margin-top: 8px;
  }
  .title {
    font-size: 40px;
    color: #ffffff;
    margin-top: 8px;
  }
  .title-win {
    font-size: 38px;
    color: #2ecc71;
    margin-top: 6px;
  }
  .title-lose {
    font-size: 38px;
    color: #e67e5a;
    margin-top: 6px;
  }
  .alert {
    font-size: 44px;
    color: #ff5a4f;
    margin-top: 8px;
  }
  .sub {
    font-size: 24px;
    color: #cfe8f7;
    margin-top: 6px;
    text-align: center;
  }
  .big {
    font-size: 34px;
    color: #ffffff;
    margin-top: 6px;
    text-align: center;
  }
  .stat {
    font-size: 22px;
    color: #ffd166;
    margin-top: 8px;
    text-align: center;
  }
  .hint {
    font-size: 20px;
    color: #9fc6dd;
    margin-top: 6px;
    text-align: center;
  }
  .hint-hot {
    font-size: 22px;
    color: #ffd166;
    margin-top: 6px;
    text-align: center;
  }

  .bar {
    width: 280px;
    height: 22px;
    margin-top: 12px;
    border-radius: 11px;
    background-color: #082338;
  }
  .bar-fill {
    height: 22px;
    border-radius: 11px;
    background-color: #29b6f6;
  }

  .pond {
    width: 300px;
    height: 150px;
    margin-top: 10px;
    border-radius: 24px;
    background-color: #14649a;
    justify-content: center;
  }
  .bobber {
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background-color: #ff5a4f;
  }

  .fight-row {
    margin-top: 8px;
    align-items: flex-start;
    justify-content: center;
  }
  .track {
    width: 140px;
    height: 300px;
    border-radius: 14px;
    background-color: #082338;
  }
  .zone {
    width: 140px;
    border-radius: 14px;
    background-color: #2e9e68;
  }
  .fish-img {
    width: 120px;
    height: 60px;
    margin-left: 10px;
  }
  .meter {
    width: 30px;
    height: 300px;
    margin-left: 22px;
    border-radius: 15px;
    background-color: #082338;
    flex-direction: column;
    justify-content: flex-end;
  }
  .meter-fill {
    width: 30px;
    border-radius: 15px;
    background-color: #ffd166;
  }
  .res-img {
    width: 150px;
    height: 75px;
  }

  .menu {
    padding-top: 36px;
    background-color: rgba(4, 18, 30, 0.82);
  }
  .menu-title {
    font-size: 30px;
    color: #ffffff;
  }
  .menu-sub {
    font-size: 22px;
    color: #ffd166;
    margin-top: 2px;
  }
  .list {
    width: 100%;
    flex-direction: column;
    align-items: center;
    margin-top: 10px;
  }
  .row {
    width: 330px;
    height: 40px;
    margin-top: 4px;
    padding-left: 12px;
    border-radius: 10px;
    background-color: #123a55;
    justify-content: center;
  }
  .row-sel {
    background-color: #2b8fc4;
  }
  .row-text {
    font-size: 21px;
    color: #ffffff;
  }
  .msg {
    font-size: 20px;
    color: #ffd166;
    margin-top: 8px;
    text-align: center;
  }
</style>

<script>
import vibrator from '@system.vibrator'
import storage from '@system.storage'
import game from '../common/game.js'

const SAVE_KEY = 'fishing_v2'
const CROWN_SENSITIVITY = 1     // общая чувствительность коронки
const MENU_STEP = 30            // сколько прокрутки на одну строку меню
const CENTER = 3000
const RECENTER_AT = 1800
const TICK_MS = 40
const SCREENS = ['fish', 'shop', 'map']

function clamp(v, a, b) { return v < a ? a : (v > b ? b : v) }

export default {
  private: {
    screen: 'fish',
    state: 'idle',
    coinsText: '',
    locName: '',
    bgSrc: '',
    powerPx: 140,
    powerText: 'Средне',
    bobY: 40,
    zoneY: 0,
    zoneH: 120,
    fishY: 0,
    fishSrc: '',
    progressPx: 90,
    resSrc: '',
    resTitle: '',
    resLine: '',
    won: false,
    gain: 0,
    bestText: '',
    rows: [],
    msg: '',
    crownSeen: false
  },

  onInit() {
    this.save = game.defaultSave()
    this.g = game.create(Math.random, this.save)
    this.timer = null
    this.lastY = CENTER
    this.recentering = false
    this.tick = 0
    this.lastTouchTick = -1000
    this.freeScrolls = 0
    this.cursor = 0
    this.acc = 0
    this.msgTimer = null
    this.loadSave()
  },

  onShow() {
    this.recenter()
    if (this.timer === null) {
      this.timer = setInterval(() => this.loop(), TICK_MS)
    }
  },

  onHide() { this.stopLoop() },
  onDestroy() { this.stopLoop() },

  stopLoop() {
    if (this.timer !== null) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  // ---------- ввод ----------

  onCrown(e) {
    const y = e.scrollY
    if (this.recentering) {
      this.recentering = false
      this.lastY = y
      return
    }
    const d = (y - this.lastY) * CROWN_SENSITIVITY
    this.lastY = y

    if (this.tick - this.lastTouchTick > 25) {
      this.freeScrolls += 1
      if (this.freeScrolls >= 3 && !this.crownSeen) this.crownSeen = true
    }

    if (d !== 0) {
      if (this.screen === 'fish') {
        game.crown(this.g, d)
      } else {
        this.moveCursor(d)
      }
    }
    if (Math.abs(y - CENTER) > RECENTER_AT) this.recenter()
  },

  // Свайп влево/вправо переключает экраны. Во время заброса и боя не работает,
  // чтобы не уйти с экрана посреди рыбалки.
  onSwipe(e) {
    if (this.state !== 'idle' && this.state !== 'result') return
    const i = SCREENS.indexOf(this.screen)
    if (e.direction === 'left') this.setScreen(SCREENS[(i + 1) % SCREENS.length])
    else if (e.direction === 'right') this.setScreen(SCREENS[(i + SCREENS.length - 1) % SCREENS.length])
  },

  onLong() {
    if (this.screen === 'fish') {
      game.longpress(this.g)
      this.sync()
    }
  },

  onTouch() {
    this.lastTouchTick = this.tick
  },

  onTap() {
    if (this.screen === 'fish') {
      game.tap(this.g)
      this.sync()
    } else {
      this.activate()
    }
  },

  setScreen(s) {
    this.screen = s
    this.cursor = 0
    this.acc = 0
    this.msg = ''
    if (s === 'fish') {
      this.applyBg()
      this.sync()
    } else {
      this.renderMenus()
    }
  },

  moveCursor(d) {
    this.acc += d
    const steps = Math.trunc(this.acc / MENU_STEP)
    if (steps === 0) return
    this.acc -= steps * MENU_STEP
    this.cursor = clamp(this.cursor + steps, 0, this.menuList().length - 1)
    this.renderMenus()
  },

  // Тап в меню: купить / надеть вещь или выбрать место
  activate() {
    const list = this.menuList()
    const it = list[this.cursor]
    if (!it) return
    this.msg = game.buy(this.save, it.cat, it.id)
    this.persist()
    this.applyBg()
    this.renderMenus()
    this.flashMsg()
  },

  flashMsg() {
    if (this.msgTimer) clearTimeout(this.msgTimer)
    this.msgTimer = setTimeout(() => { this.msg = '' }, 2500)
  },

  // ---------- меню ----------

  menuList() {
    if (this.screen === 'shop') {
      return game.shopItems(this.save, 'rod')
        .concat(game.shopItems(this.save, 'reel'), game.shopItems(this.save, 'bait'))
    }
    return game.LOCATIONS.map(loc => ({
      cat: 'loc',
      id: loc.id,
      name: loc.name,
      price: loc.price,
      owned: this.save.owned.loc.indexOf(loc.id) >= 0,
      equipped: this.save.eq.loc === loc.id
    }))
  },

  renderMenus() {
    this.coinsText = 'Монеты: ' + this.save.coins
    const list = this.menuList()
    const start = clamp(this.cursor - 1, 0, Math.max(0, list.length - 4))
    const rows = []
    for (let i = start; i < list.length && rows.length < 4; i++) {
      const it = list[i]
      let mark = it.owned ? (it.equipped ? '● ' : '○ ') : ''
      let tail = it.owned ? (it.equipped ? 'надето' : 'есть') : (it.price + ' монет')
      rows.push({
        text: mark + it.name + ' — ' + tail,
        cls: 'row' + (i === this.cursor ? ' row-sel' : '')
      })
    }
    this.rows = rows
  },

  applyBg() {
    const loc = game.gear(this.g).loc
    this.bgSrc = '/common/img/bg_' + loc.id + '.png'
    this.locName = loc.name
  },

  // ---------- игровой цикл ----------

  recenter() {
    const el = this.$element('crown')
    if (!el) return
    this.recentering = true
    this.lastY = CENTER
    el.scrollTo({ top: CENTER, left: 0, behavior: 'instant' })
  },

  loop() {
    this.tick += 1
    game.step(this.g, TICK_MS / 1000)
    this.sync()
  },

  sync() {
    const g = this.g

    while (g.events.length) {
      const ev = g.events.shift()
      if (ev === 'bite') vibrator.vibrate({ mode: 'long' })
      else if (ev === 'hook' || ev === 'lose') vibrator.vibrate({ mode: 'short' })
      else if (ev === 'win') vibrator.vibrate({ mode: 'long' })
    }

    if (this.state !== g.state) this.state = g.state
    this.coinsText = 'Монеты: ' + this.save.coins

    if (g.state === 'idle') {
      const px = Math.round(g.power * 2.8)
      if (this.powerPx !== px) this.powerPx = px
      const t = game.powerLabel(g.power)
      if (this.powerText !== t) this.powerText = t
    }

    if (g.state === 'casting' || g.state === 'wait' || g.state === 'bite') {
      const b = Math.round(g.bobY)
      if (this.bobY !== b) this.bobY = b
    }

    if (g.state === 'fight') {
      const z = Math.round(g.zoneY)
      const f = Math.round(g.fishY)
      const p = Math.round(g.progress * 3)
      if (this.zoneY !== z) this.zoneY = z
      if (this.zoneH !== g.zoneH) this.zoneH = g.zoneH
      if (this.fishY !== f) this.fishY = f
      if (this.progressPx !== p) this.progressPx = p
      const src = '/common/img/fish_' + g.fishId + '.png'
      if (this.fishSrc !== src) this.fishSrc = src
    }

    if (g.state === 'result' && g.last) {
      const L = g.last
      if (this.won !== L.won) this.won = L.won
      if (this.gain !== L.gain) this.gain = L.gain
      if (this.resTitle !== L.title) this.resTitle = L.title
      if (this.resLine !== L.line) this.resLine = L.line
      const src = '/common/img/fish_' + L.fishId + '.png'
      if (this.resSrc !== src) this.resSrc = src
    }

    const st = this.save.stats
    const best = st.bestKg > 0 ? game.FISH[st.bestId].name + ' ' + st.bestKg + ' кг' : ''
    if (this.bestText !== best) this.bestText = best

    if (g.dirty) {
      g.dirty = false
      this.persist()
    }
  },

  // ---------- сохранение ----------

  persist() {
    try {
      storage.set({ key: SAVE_KEY, value: JSON.stringify(this.save) })
    } catch (err) {
      console.warn('save failed')
    }
  },

  loadSave() {
    storage.get({
      key: SAVE_KEY,
      default: '',
      success: (data) => {
        if (!data) {
          this.applyBg()
          return
        }
        try {
          this.save = game.mergeSave(JSON.parse(data))
          this.g.save = this.save
          this.applyBg()
          this.sync()
          this.renderMenus()
        } catch (err) {
          console.warn('save parse failed')
        }
      }
    })
  }
}
</script>
